# --------------------------------------------------------------
# Switch between local SQLite dev database and Supabase (PostgreSQL) production database
# --------------------------------------------------------------

# Choose the provider you want to use (only one should be uncommented)
# For local development with SQLite
PRISMA_PROVIDER=sqlite
# For Supabase (PostgreSQL) – uncomment the line below and comment the sqlite line above
# PRISMA_PROVIDER=postgresql

# --------------------------------------------------------------
# Database connection URL – depends on the provider above
# SQLite local file (used when PRISMA_PROVIDER=sqlite)
DATABASE_URL="file:./prisma/dev.db"

# Supabase PostgreSQL connection string (used when PRISMA_PROVIDER=postgresql)
# Replace <USER>, <PASSWORD>, <HOST>, <DB> with your Supabase credentials
# DATABASE_URL="postgresql://<USER>:<PASSWORD>@<HOST>.supabase.co:5432/<DB>?sslmode=require"

# --------------------------------------------------------------
# Supabase client keys (optional – needed if you call Supabase from the frontend)
# NEXT_PUBLIC_SUPABASE_URL – URL of your Supabase project (frontend)
# NEXT_PUBLIC_SUPABASE_ANON_KEY – public anon key (frontend)
# SUPABASE_SERVICE_ROLE_KEY – service role key (server‑side, keep secret)
# NEXT_PUBLIC_SUPABASE_URL="https://<YOUR-PROJECT>.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# SUPABASE_SERVICE_ROLE_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# --------------------------------------------------------------
# Local auth fallback used when DB_PROVIDER=sqlite (kept for backward compatibility)
LOCAL_AUTH_EMAIL=
LOCAL_AUTH_PASSWORD=

# Optional: secret for photo migration endpoint
MIGRATE_PHOTOS_SECRET=
